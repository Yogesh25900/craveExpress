# ── Frontend environment ──────────────────────────────────────────────────────
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle. Never put
# secrets here — anything prefixed NEXT_PUBLIC_ is inlined into the client JS.

# Base URL of the backend API. In local dev the app falls back to this value,
# so it's optional locally but REQUIRED when the API is not on localhost
# (production, Docker, a deployed host).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# hCaptcha site key for the login CAPTCHA. Optional — falls back to hCaptcha's
# always-pass test key in development. Set your real key from hcaptcha.com in prod.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
