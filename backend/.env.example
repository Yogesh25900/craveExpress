# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/craveexpress

# ── JWT secrets — generate with: openssl rand -hex 64 ────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Frontend origin ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ── hCaptcha ──────────────────────────────────────────────────────────────────
# Development: the all-pass test secret below works without registration.
# Production:  register at hcaptcha.com and replace with your real secret.
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ── MFA — AES-256-GCM encryption key ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
# Must be exactly 64 hex characters (= 32 bytes = 256 bits).
MFA_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── CSRF — HMAC signing secret ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CSRF_SECRET=your_csrf_secret_here

# ── PII encryption — AES-256-GCM key for phone + addresses at rest ────────────
# Generate with: openssl rand -hex 64
# Separate key from MFA_ENCRYPTION_KEY so they can be rotated independently.
PII_ENCRYPTION_KEY=your_64_char_hex_pii_key_here

# ── OAuth2 / SSO — Google ─────────────────────────────────────────────────────
# Register a Web OAuth client at https://console.cloud.google.com/apis/credentials
# The authorised redirect URI must exactly match GOOGLE_CALLBACK_URL below.
# Leave CLIENT_ID/SECRET blank to disable Google sign-in (endpoints return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback
# HMAC secret protecting the OAuth redirect against CSRF — generate: openssl rand -hex 32
OAUTH_STATE_SECRET=your_oauth_state_secret_here

# ── Payment — eSewa ePay v2 (Nepal) ───────────────────────────────────────────
# The sandbox defaults below (test merchant EPAYTEST + its published test secret)
# work out-of-the-box for development. Replace with LIVE merchant credentials and
# the production URLs for a real deployment.
#   Production form URL:   https://epay.esewa.com.np/api/epay/main/v2/form
#   Production status URL: https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
